# SoftMarket Kenya — Environment Variable Reference & Configuration
#
# Production (Vercel): Set these as environment variables in the project dashboard.
# Local Development: Defaults allow SQLite and console email backend to work out-of-the-box.
# Never commit real credentials to source control.

# --- Core Django Settings ---
DJANGO_SECRET_KEY=django-insecure-softmarket-kenya-change-this-in-production-long-random-key-64-chars
DJANGO_DEBUG=True                        # True for local development; MUST be False in production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost # Comma-separated; *.vercel.app is handled automatically
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://softmarket.co.ke

# --- Database Configuration (PostgreSQL in production; SQLite locally) ---
# DATABASE_URL=postgresql://softmarket_user:dummy_db_password_here@ep-dummy-neon-host.us-east-2.aws.neon.tech/softmarket_prod?sslmode=require

# --- Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=dummy-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz_1234

# --- Email Notifications (Console backend locally by default) ---
ADMIN_NOTIFICATION_EMAILS=admin@softmarket.co.ke,alerts@softmarket.co.ke
DEFAULT_FROM_EMAIL=SoftMarket Kenya <hello@softmarket.co.ke>
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.dummy_sendgrid_key_string_placeholder
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# --- SMS Webhook Notifications (Africa's Talking / Twilio / Custom) ---
SOFTMARKET_SMS_WEBHOOK_URL=https://api.sms-provider.com/v1/send
SOFTMARKET_SMS_WEBHOOK_TOKEN=dummy_sms_bearer_token_xyz

# --- CORS Configuration (Next.js Frontend consuming /api/) ---
DJANGO_CORS_ALLOW_ALL=False
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,https://softmarket.co.ke

# --- M-Pesa Daraja 2.0 Integration ---
MPESA_ENVIRONMENT=sandbox                          # sandbox | production
MPESA_CONSUMER_KEY=dummy_daraja_consumer_key_xyz12345
MPESA_CONSUMER_SECRET=dummy_daraja_consumer_secret_abc67890
MPESA_BUSINESS_SHORTCODE=174379                   # Paybill or Buy Goods Till number
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline      # CustomerPayBillOnline | CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=https://softmarket.co.ke/payments/mpesa/callback/
# Shared secret guarding the callback URL from unauthenticated forged requests:
# Register callback URL as: https://softmarket.co.ke/payments/mpesa/callback/?token=<MPESA_CALLBACK_TOKEN>
MPESA_CALLBACK_TOKEN=smk_sec_token_9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d

# --- Production Security & HTTPS Hardening ---
DJANGO_SECURE_SSL_REDIRECT=False                  # Set True in production once HTTPS is active
DJANGO_SESSION_COOKIE_SECURE=False                # Set True in production
DJANGO_CSRF_COOKIE_SECURE=False                   # Set True in production
DJANGO_SECURE_HSTS_SECONDS=2592000                 # 30 days HSTS header
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_ALLOWED_HOSTS_EXTRA=
