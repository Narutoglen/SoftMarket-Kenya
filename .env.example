# SoftMarket Kenya — environment variable reference.
#
# The app reads REAL environment variables (settings.py uses os.environ; there is
# no dotenv auto-loader). So this file is a reference:
#   * Production (Vercel): set these as project env vars.
#   * Local: you need NOTHING for a basic run — with DJANGO_DEBUG=True (the local
#     default) and no DATABASE_URL the app uses db.sqlite3 and the console email
#     backend. Set any var below only when you want to exercise that integration,
#     e.g. `export MPESA_CONSUMER_KEY=...` (Unix) / `$env:MPESA_CONSUMER_KEY=...`
#     (PowerShell), or add your own dotenv loader.
# Never commit real secrets.

# --- Core Django ---
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True                        # True locally (uses db.sqlite3); MUST be False in production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost # comma-separated; VERCEL_URL is picked up automatically
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Database (Postgres in prod; omit locally to use SQLite) ---
DATABASE_URL=postgresql://user:pass@your-neon-or-supabase-host/dbname

# --- Media storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email notifications (console backend by default) ---
ADMIN_NOTIFICATION_EMAILS=you@example.com
DEFAULT_FROM_EMAIL=SoftMarket Kenya <hello@example.com>
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- SMS webhook (optional) ---
SOFTMARKET_SMS_WEBHOOK_URL=
SOFTMARKET_SMS_WEBHOOK_TOKEN=

# --- CORS (Next.js frontend consuming /api/) ---
# Leave DJANGO_CORS_ALLOW_ALL off; list the exact frontend origins instead.
DJANGO_CORS_ALLOW_ALL=False
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# --- M-Pesa Daraja (STK Push) ---
MPESA_ENVIRONMENT=sandbox                # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline  # or CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=https://your-domain.com/payments/mpesa/callback/
# Shared secret guarding the callback URL (added by the security-hardening PR;
# register the callback with Safaricom as .../callback/?token=<this value>).
MPESA_CALLBACK_TOKEN=

# --- Optional production security hardening (enable once the final domain is HTTPS-only) ---
# These default sensibly from DJANGO_DEBUG; override only to tune.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=2592000       # 30 days
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Extra hostnames to append to ALLOWED_HOSTS (comma-separated); VERCEL_URL and
# *.vercel.app are already trusted automatically.
DJANGO_ALLOWED_HOSTS_EXTRA=
