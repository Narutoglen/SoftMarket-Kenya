{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "python manage.py collectstatic --no-input",
  "functions": {
    "softmarket/wsgi.py": {
      "runtime": "@vercel/python@6.0.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/staticfiles/$1" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "softmarket/wsgi.py" }
  ]
}
